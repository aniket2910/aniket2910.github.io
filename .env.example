# Frontend (Next.js) env. The AI/agent + model config now lives in backend/.env
# (the NestJS backend owns the agent). This site only needs to know where the
# backend is and which STT mode the client should use.

# URL of the NestJS voice/chat backend (browser calls it directly).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# STT mode for the client: browser (free Web Speech API) | local (record → backend /stt)
NEXT_PUBLIC_STT_PROVIDER=browser
