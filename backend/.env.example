# NestJS backend config — copy to `backend/.env`. The all-local defaults below
# match docker-compose.yml, so with the containers up this runs at $0 with no
# edits. Only set keys/overrides you actually need.

# Server
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Brain (LLM): local | openai | gemini
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Ears (STT): browser | local  — local forwards to the faster-whisper container
STT_PROVIDER=local
STT_URL=http://localhost:8001/v1
STT_MODEL=Systran/faster-whisper-small

# Mouth (TTS): local | gemini
TTS_PROVIDER=local
TTS_URL=http://localhost:8002/v1
TTS_MODEL=kokoro
TTS_VOICE=af_heart
